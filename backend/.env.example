# Django
SECRET_KEY=change-this-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (MySQL only)
DB_NAME=roadresq
DB_USER=roadresq_user
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=3306

# Frontend
FRONTEND_URL=http://localhost:5173

# JWT
ACCESS_TOKEN_LIFETIME_MIN=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# Email (used for OTP delivery). For local dev, leave EMAIL_HOST blank to
# fall back to Django's console backend (OTP emails print to the runserver
# console instead of actually sending).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=RoadResQ <no-reply@roadresq.in>

# SMS (optional, provider-independent interface — see accounts/otp.py)
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=

# OTP
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30

# Google Maps (server-side geocoding — never exposed to the frontend bundle)
GOOGLE_MAPS_API_KEY=

# AI Assistant (optional — falls back to rule-based diagnosis if unset)
AI_API_KEY=
AI_API_URL=

# Razorpay (structural integration only — see payments/gateways.py)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Push notifications (optional, structural only)
FIREBASE_CREDENTIALS=

# Channels / Redis (leave blank in dev to use the in-memory channel layer,
# which only works for a single runserver/daphne process)
REDIS_URL=
